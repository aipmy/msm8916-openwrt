#!/bin/sh /etc/rc.common
#
# sim-hotplug - detect a physical SIM swap from the modem's UIM card status and
# re-announce the card to the baseband (see /usr/sbin/sim-hotplug).
#
USE_PROCD=1
START=98
STOP=10

# The sim_hotplug line is exposed as a gpio-leds node on boards that have it
# (HMUF02-V5, patch 805).  Without a writable node, hot-swap can never make
# the modem re-read the slot, so running the service is pointless and would
# otherwise spin the absent-reannounce loop forever on a card-less board.
SIM_LED="/sys/class/leds/sim_hotplug/brightness"

start_service() {
	. /lib/functions.sh
	config_load sim-hotplug
	config_get_bool ENABLED general enabled 1
	[ "$ENABLED" -eq 0 ] && return 0
	[ -w "$SIM_LED" ] || {
		logger -t sim-hotplug "no sim_hotplug line on this board - disabled"
		return 0
	}
	procd_open_instance
	procd_set_param command /usr/sbin/sim-hotplug start
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

rescan() {
	[ -w "$SIM_LED" ] || {
		logger -t sim-hotplug "no sim_hotplug line on this board - rescan is a no-op"
		return 1
	}
	/usr/sbin/sim-hotplug rescan
}

extra_command rescan "Force a SIM re-announce (use after a physical SIM swap)"
