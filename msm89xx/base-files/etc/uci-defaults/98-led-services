#!/bin/sh

# Enable LED monitor services only on boards exposing the
# standard LED names used by the modem/wifi monitors.

if [ -d /sys/class/leds/red:power ] &&
   ( [ -d /sys/class/leds/green:wlan ] || [ -d /sys/class/leds/green:wan ] ) &&
   ( [ -d /sys/class/leds/blue:wan ] || [ -d /sys/class/leds/blue:wlan ] ); then

    [ -x /etc/init.d/modem-led-monitor ] &&
        /etc/init.d/modem-led-monitor enable

    # wifi-led-monitor disabled: green LED is reserved for WAN (wwan0) via netdev trigger
    # [ -x /etc/init.d/wifi-led-monitor ] &&
    #    /etc/init.d/wifi-led-monitor enable
fi

exit 0
