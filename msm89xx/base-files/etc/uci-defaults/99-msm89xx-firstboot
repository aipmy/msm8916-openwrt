#!/bin/sh

#
# MSM8916 first-boot configuration
#

###############################################################################
# Configure ModemManager WAN interface
###############################################################################

uci -q batch << 'EOF'
set network.modem=interface
set network.modem.proto='modemmanager'
set network.modem.device='qcom-soc'
set network.modem.auth='none'
set network.modem.apn='internet'
set network.modem.peerdns='0'
add_list network.modem.dns='1.1.1.1'
add_list network.modem.dns='8.8.8.8'
set network.modem.allowedmode='4g'
set network.modem.preferredmode='none'
set network.modem.ifname='wwan0'
EOF

uci -q del_list firewall.@zone[1].network='modem' 2>/dev/null || true
uci add_list firewall.@zone[1].network='modem'

# Device specific initialization

###############################################################################
# MSM8916 devices do not expose an eth0 interface.
###############################################################################

uci -q del_list network.@device[0].ports='eth0' 2>/dev/null || true
uci -q del_list network.@device[0].ports='usb0' 2>/dev/null || true
uci add_list network.@device[0].ports='usb0'

sed -i \
    's/"device": "eth0"/"device": "br-lan"/g' \
    /etc/board.json

###############################################################################
# Remove the automatically generated target package feed.
#
# msm89xx is not an official OpenWrt target, therefore:
#
#   https://downloads.openwrt.org/releases/<version>/targets/msm89xx/msm8916/
#
# does not exist.
#
# The generic package feeds remain intact.
#
###############################################################################

sed -i \
    -e '\|/targets/msm89xx/msm8916/packages|d' \
    -e '\|/smsmanager/packages.adb|d' \
    /etc/apk/repositories.d/distfeeds.list \
    2>/dev/null || true

cat << 'EOF' > /etc/apk/repositories.d/customfeeds.list
https://akbar-npj.github.io/msm8916-openwrt/releases/25.12.5/targets/msm89xx/msm8916/packages/packages.adb
https://akbar-npj.github.io/msm8916-openwrt/releases/25.12.5/packages/aarch64_generic/base/packages.adb
https://akbar-npj.github.io/msm8916-openwrt/releases/25.12.5/packages/aarch64_generic/packages/packages.adb
EOF

# Ensure repository signing key for akbar-npj custom feeds exists.
#
# This is the public half of the persistent key the CI release job signs the
# package feed with (repo secret APK_SIGNING_KEY).  It is also embedded in the
# image at /etc/apk/keys/akbar-npj-v25.12.5.pem via base-files.  The apk-key-refresh
# service keeps it in sync with the canonical key published at a stable URL, so a
# device flashed with an older image self-heals instead of rejecting the feed with
# "UNTRUSTED signature".
if [ ! -f /etc/apk/keys/akbar-npj-v25.12.5.pem ]; then
    mkdir -p /etc/apk/keys
    cat << 'EOF' > /etc/apk/keys/akbar-npj-v25.12.5.pem
-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEVuQP6A+xWmNj1/rPFN+9adeTnVrG
oxFMGAsoNcx1eInT4k6nu3H8Azjzaluvuk1VPQ11tE+XaIgDBEI8rms84A==
-----END PUBLIC KEY-----
EOF
fi

###############################################################################
# Configure LAN IP Subnet (192.168.8.1 to prevent home Wi-Fi 192.168.1.x conflict)
###############################################################################

uci -q batch << 'EOF'
set network.lan.ipaddr='192.168.8.1'
set network.lan.netmask='255.255.255.0'
EOF

###############################################################################
# Configure USB Gadget (CDC NCM Ethernet)
###############################################################################

uci -q batch << 'EOF'
set usbgadget.usb=device
set usbgadget.usb.enabled='1'
set usbgadget.usb.gadget_name='g1'
set usbgadget.usb.vendor_id='0x1d6b'
set usbgadget.usb.product_id='0x0104'
set usbgadget.usb.device_version='0x0100'
set usbgadget.usb.manufacturer='Linux'
set usbgadget.usb.product='USB Gadget'
set usbgadget.ncm=function
set usbgadget.ncm.enabled='1'
set usbgadget.ncm.description='CDC NCM ethernet (Best Performance)'
set usbgadget.acm=function
set usbgadget.acm.enabled='1'
set usbgadget.acm.description='Serial console'
set usbgadget.acm.shell='1'
EOF

###############################################################################
# Hostname configuration
###############################################################################

uci set system.@system[0].hostname="ModemRadar"
echo "ModemRadar" > /proc/sys/kernel/hostname 2>/dev/null || true

###############################################################################
# Hardware LED Configuration (LAN & WAN netdev link/tx/rx)
###############################################################################

uci -q batch << 'EOF'
set system.led_lan='led'
set system.led_lan.name='LAN'
set system.led_lan.sysfs='blue:wlan'
set system.led_lan.trigger='netdev'
set system.led_lan.dev='br-lan'
set system.led_lan.mode='link tx rx'

set system.led_wan='led'
set system.led_wan.name='WAN'
set system.led_wan.sysfs='green:wan'
set system.led_wan.trigger='netdev'
set system.led_wan.dev='wwan0'
set system.led_wan.mode='link tx rx'
commit system
EOF

###############################################################################
# Set Proton2025 as default LuCI theme
###############################################################################

uci -q set luci.main.mediaurlbase='/luci-static/proton2025'

###############################################################################
# Configure Web Terminal (ttyd auto-login root)
###############################################################################

uci -q batch << 'EOF'
set ttyd.@ttyd[0].command='/bin/login -f root'
commit ttyd
EOF

###############################################################################
# Configure Default TTL Spoofing / Fix (TTL 64 for Hotspot Bypass)
###############################################################################

cat << 'EOF' > /etc/firewall.ttl
table inet fw4 {
    chain mangle_forward_ttl {
        type filter hook forward priority mangle; policy accept;
        ip ttl set 64
        ip6 hoplimit set 64
    }
}
EOF

uci -q batch << 'EOF'
add firewall include
set firewall.@include[-1].path='/etc/firewall.ttl'
set firewall.@include[-1].type='nftables'
set firewall.@include[-1].position='ruleset-append'
commit firewall
EOF

uci commit

[ -x /etc/init.d/umount-overlay ] && /etc/init.d/umount-overlay enable

exit 0
