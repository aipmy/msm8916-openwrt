#!/bin/sh /etc/rc.common
# Background collector for the SMS archive.
#
# Message arrival is event-driven: ModemManager announces every new message on
# the system bus, so the archive is updated and forwarding fires within about a
# second of delivery. There is deliberately no poll interval to configure.
#
# A slow maintenance tick runs alongside it for the work that is inherently
# time-based — retrying the outbox and the scheduled operator query. Delivery
# reports are not polled: they arrive as their own message and are handled by
# the same event-driven sync. It re-runs a sync as well, which costs almost nothing and
# covers a signal missed while dbus or ModemManager was restarting.
START=96
USE_PROCD=1

CTL=/usr/bin/smsctl

# Maintenance period, seconds. This is not a message poll — nothing here waits
# on new messages, so a long period costs nothing.
TICK=5

start_service() {
	# The listener exits whenever dbus-monitor does (a bus restart, say) and
	# procd brings it straight back. `respawn ... 0` retries indefinitely, so
	# a listener that starts before the bus is ready is not given up on after
	# the default five attempts.
	procd_open_instance listener
	procd_set_param command "$CTL" listen
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance maintenance
	procd_set_param command /bin/sh -c "while :; do
		sleep $TICK
		$CTL queue-flush    >/dev/null 2>&1
		$CTL ussd-scheduled >/dev/null 2>&1
		$CTL sync           >/dev/null 2>&1
	done"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() { procd_add_reload_trigger "sms"; }
